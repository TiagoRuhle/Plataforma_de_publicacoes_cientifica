# Copie para ".env" se precisar de mudar alguma coisa (o ".env" não vai para o git).
# URL da API do backend (WildFly). Por omissão: http://localhost:8080/projeto/api
VITE_API_URL=http://localhost:8080/projeto/api
# Tamanho máximo de upload em MB (deve coincidir com MAX_UPLOAD_MB do backend)
VITE_MAX_UPLOAD_MB=50
