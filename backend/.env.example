# Copie para ".env" e ajuste. O ".env" NUNCA deve ir para o git.
APPLICATION_NAME=projeto

DATASOURCE_JNDI=java:/AcademicsDS
DATASOURCE_NAME=AcademicsDS

DB_USER=postgres
DB_PASS=troque-esta-password
DB_HOST=db
DB_PORT=5432
DB_NAME=projeto

POSTGRES_DRIVER_VERSION=42.5.4

WILDFLY_ADMIN_PASSWORD=troque-esta-password

# Segredo de assinatura dos JWT (mínimo 48 caracteres). Gere um com:
#   openssl rand -hex 32                              (Linux/Mac/Git Bash)
#   -join ((1..64) | % { '{0:x}' -f (Get-Random -Max 16) })    (PowerShell)
JWT_SECRET=gere-um-valor-aleatorio-com-pelo-menos-48-caracteres

# Frontend (origem permitida no CORS e base dos links nos e-mails)
CORS_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:5173

# IA
OLLAMA_MODEL=llama3.2

# --- Limites e resiliência (opcionais; os valores abaixo são os por omissão) ---
# Tamanho máximo de upload. O Undertow está configurado para 60 MB (docker/undertow.cli): ao aumentar
# MAX_UPLOAD_MB tem de aumentar também esse valor.
#MAX_UPLOAD_MB=50
# Resumos de IA em simultâneo (o Ollama em CPU trata um de cada vez) e quantos esperam na fila
#AI_MAX_CONCURRENT=1
#AI_MAX_QUEUE=20
# Circuit breaker: falhas seguidas do Ollama que o abrem, e durante quantos segundos falha logo
#AI_BREAKER_FAILURES=3
#AI_BREAKER_OPEN_SECONDS=60
# Extração de texto de PDF: páginas e tempo máximos
#PDF_MAX_PAGES=150
#PDF_TIMEOUT_SECONDS=60
